{
  "name": "@tummycrypt/tinyland-physics",
  "version": "0.2.2",
  "description": "Physics simulation engines for blob animations, scroll handling, and device motion",
  "type": "module",
  "license": "(Zlib AND LicenseRef-Tinyland-Proprietary)",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build && pnpm check:package",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:package": "publint"
  },
  "keywords": [
    "physics",
    "animation",
    "blob",
    "wasm",
    "scroll",
    "device-motion"
  ],
  "author": "Tinyland Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinyland-inc/tinyland-physics.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "happy-dom": "^17.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.0",
    "publint": "^0.3.18"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "packageManager": "pnpm@10.13.1",
  "homepage": "https://github.com/tinyland-inc/tinyland-physics",
  "bugs": {
    "url": "https://github.com/tinyland-inc/tinyland-physics/issues"
  }
}